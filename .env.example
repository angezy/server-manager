PORT=3010
HOST=0.0.0.0
NODE_ENV=development
DATABASE_PATH=./data/server-manager.sqlite
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_NAME=server_manager_session
FRONTEND_ORIGIN=http://localhost:5173
TRUST_PROXY=false
HOST_AGENT_SOCKET=/run/server-manager/agent.sock
HOST_AGENT_MODE=socket
PM2_ALLOWLIST=
DOCKER_CONTAINER_ALLOWLIST=
DOCKER_PROJECT_ALLOWLIST=
SYSTEMD_SERVICE_ALLOWLIST=
SERVER_MANAGER_PATH_ALLOWLIST=
GIT_REPO_ALLOWLIST=
HIDDIFY_PATH_ALLOWLIST=
HIDDIFY_SERVICE_ALLOWLIST=
HIDDIFY_CONTAINER_ALLOWLIST=
HIDDIFY_VOLUME_ALLOWLIST=
SITE_DOMAIN=

LLM_ENABLED=true
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_FALLBACK_MODELS=
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_MAX_AGENT_STEPS=8
LLM_MAX_RETRIES=3

CPU_WARNING_PERCENT=80
CPU_CRITICAL_PERCENT=95
RAM_WARNING_PERCENT=80
RAM_CRITICAL_PERCENT=95
DISK_WARNING_PERCENT=80
DISK_CRITICAL_PERCENT=90
SSL_WARNING_DAYS=30
SSL_CRITICAL_DAYS=7
LOAD_WARNING_MULTIPLIER=1.5
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
SESSION_TTL_MS=28800000
CONFIRMATION_TTL_MS=300000
LOG_DIR=./logs
