server {
    listen 80;
    server_name manager.example.com;
    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location /api/ { proxy_pass http://127.0.0.1:3010; proxy_set_header Host $host; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; proxy_read_timeout 75s; }
    location / { root /opt/server-manager/dist/frontend; try_files $uri $uri/ /index.html; }
}
